{
  "skills": [
    {
      "repo": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git",
      "path": ".claude/skills",
      "include": ["ui-ux-pro-max", "slides"]
    },
    {
      "repo": "https://github.com/anthropics/claude-plugins-official.git",
      "path": "plugins/frontend-design/skills",
      "include": ["frontend-design"]
    },
    {
      "repo": "https://github.com/cathrynlavery/diagram-design.git"
    },
    {
      "repo": "https://github.com/microsoft/playwright-cli.git",
      "include": ["playwright-cli"]
    },
    {
      "repo": "https://github.com/citrolabs/ego-lite.git",
      "path": "skills",
      "include": ["ego-browser"]
    },
    {
      "repo": "https://github.com/anthropics/skills.git",
      "path": "skills",
      "include": ["skill-creator", "mcp-builder", "webapp-testing"]
    },
    {
      "repo": "https://github.com/addyosmani/agent-skills.git",
      "path": "skills",
      "include": [
        "code-review-and-quality",
        "debugging-and-error-recovery"
      ]
    },
    {
      "repo": "https://github.com/github/awesome-copilot.git",
      "path": "skills",
      "include": ["git-commit"]
    },
    {
      "repo": "https://github.com/mattpocock/skills.git",
      "path": "skills/productivity",
      "include": ["grilling"]
    },
    {
      "repo": "https://github.com/vercel-labs/agent-skills.git",
      "path": "skills",
      "include": [
        "web-design-guidelines",
        "react-view-transitions",
        "composition-patterns"
      ]
    }
  ],
  "agents": [
    {
      "repo": "https://github.com/VoltAgent/awesome-claude-code-subagents.git",
      "path": "categories",
      "include": ["code-reviewer"]
    }
  ],
  "prompts": [],
  "commands": [],
  "plugins": [
    {
      "repo": "https://github.com/DietrichGebert/ponytail.git",
      "capabilities": {
        "skills": [{ "path": "skills", "include": ["ponytail-audit", "ponytail-review"] }],
        "commands": [{ "include": ["ponytail-audit", "ponytail-review"] }]
      }
    },
    {
      "repo": "https://github.com/cursor/plugins.git",
      "capabilities": {
        "skills": [{ "path": "pstack/skills" }],
        "agents": [{ "path": "pstack/agents" }]
      }
    }
  ]
}
