{
  "name": "dev-plugin",
  "version": "0.0.5",
  "description": "Personal cross-tool agent plugin: skills and MCP servers for Claude Code, Codex, Kimi Code and pi.",
  "keywords": [
    "personal",
    "skills",
    "mcp"
  ],
  "author": {
    "name": "jeryfan"
  },
  "license": "MIT",
  "skills": [
    "./skills/"
  ],
  "commands": "./commands/",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
