{
  "name": "dev-plugin",
  "version": "0.0.5",
  "description": "Personal cross-tool agent plugin: skills and MCP servers for Claude Code, Codex, Kimi Code and pi.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync-mcp.js && node scripts/sync-sources.js",
    "bump-version": "node scripts/bump-version.js",
    "postinstall": "node scripts/setup-pi.js"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/@narumitw/pi-btw/dist/index.ts",
      "node_modules/@narumitw/pi-plan-mode/dist/index.ts",
      "node_modules/pi-rewind/src/index.ts",
      "node_modules/pi-web-access/index.ts",
      "node_modules/context-mode/build/adapters/pi/extension.js",
      "node_modules/pi-subagents/index.js",
      "node_modules/pi-review-loop/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/context-mode/skills",
      "node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./prompts",
      "./commands",
      "node_modules/pi-subagents/prompts",
      "node_modules/pi-review-loop/prompts"
    ]
  },
  "dependencies": {
    "@narumitw/pi-btw": "^0.61.1",
    "@narumitw/pi-plan-mode": "^0.59.0",
    "context-mode": "^1.0.169",
    "pi-review-loop": "^0.4.4",
    "pi-rewind": "^0.5.0",
    "pi-subagents": "^0.76.1",
    "pi-web-access": "^0.37.0"
  }
}
