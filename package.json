{
  "name": "dev-plugin",
  "version": "0.0.8",
  "description": "Personal cross-tool agent plugin: skills and MCP servers for Claude Code, Codex, Kimi Code and pi.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync-mcp.js && node scripts/sync-sources.js",
    "bump-version": "node scripts/bump-version.js",
    "postinstall": "node scripts/setup-pi.js"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/@narumitw/pi-btw/dist/index.ts",
      "node_modules/@narumitw/pi-plan-mode/dist/index.ts",
      "node_modules/pi-rewind/src/index.ts",
      "node_modules/pi-web-access/dist/index.js",
      "node_modules/billion-context-pi/dist/index.js",
      "node_modules/pi-review-loop/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts",
      "./commands",
      "node_modules/pi-review-loop/prompts"
    ]
  },
  "dependencies": {
    "@narumitw/pi-btw": "^0.63.5",
    "@narumitw/pi-plan-mode": "^0.60.0",
    "billion-context-pi": "^0.1.83",
    "pi-review-loop": "^0.4.4",
    "pi-rewind": "^0.5.0",
    "pi-web-access": "^0.47.0"
  }
}
